{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "multimodal-looker": {
      "model": "google/gemini-3.5-flash",
      "mode": "subagent",
      "description": "Analyzes media files (PDFs, images, diagrams) that require interpretation beyond raw text.",
    },
    "oracle": {
      "model": "google/gemini-3.1-pro",
      "fallback_models": ["google/gemini-2.5-pro", "google/gemini-3.5-flash", "google/gemini-2.5-flash"],
      "mode": "subagent",
    },
  },
  "triage": {
    "enabled": true,
    "modelPath": "model/triage.tflite",
    "threshold": 0.7
  },
  "experimental": {
    "learning": {
      "review": true,
      "provider": "deepseek",
      "model": "deepseek-chat",
      "fallback": [{ "provider": "google", "model": "gemini-2.5-flash" }],
      "gate": {
        "enabled": false,
        "threshold": 0.5,
        "modelPath": "model/learning-gate.tflite"
      }
    },
    "tf": {
      "enabled": true,
      "triage": {
        "enabled": true,
        "threshold": 0.7,
        "modelPath": "model/triage.tflite"
      },
      "gate": {
        "enabled": false,
        "threshold": 0.5,
        "modelPath": "model/learning-gate.tflite"
      },
      "pii": {
        "denyConfidence": 0.8
      }
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "timeout": 60000,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
      },
    },
  },
}
