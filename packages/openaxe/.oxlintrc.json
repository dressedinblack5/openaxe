{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "require-yield": "off",
    "no-control-regex": "off",
    "no-unused-expressions": "warn",
    "no-unassigned-vars": "warn",
    "triple-slash-reference": "warn",
    "no-unused-vars": "warn"
  },
  "env": {
    "builtin": true
  }
}